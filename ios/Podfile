# The project was created on Windows, where `flutter create` never generates a
# Podfile, so this one is written by hand. iOS 15.5 is the floor the current
# dependency set forces: Firebase (core/auth/app_check/ai) needs 15.0 and
# google_mlkit_face_detection needs 15.5.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The ShareExtension target is deliberately absent: it links nothing but UIKit
# and Foundation, and shares exactly one source file with the app
# (Runner/SharedProfileInbox.swift). Pulling the Flutter engine or any pod into
# an app extension would blow past the extension memory limit for no gain.

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # A pod that ships an older floor than ours would otherwise warn and, for
      # the Firebase pods, fail to build.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # permission_handler compiles *every* permission handler unless told
      # otherwise, and App Store review rejects a binary that references e.g.
      # the camera or location APIs with no matching usage description in
      # Info.plist. The app only ever asks for the photo library
      # (`Permission.photos` in lib/services/photo_picker_service.dart);
      # contacts go through flutter_contacts and notifications through
      # flutter_local_notifications, so both stay off here.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_CAMERA=0',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=0',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
