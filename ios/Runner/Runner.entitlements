<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- Shared with the ShareExtension target: the extension parks an
		     incoming share in this group's container and the app drains it.
		     See ios/Runner/SharedProfileInbox.swift. -->
		<key>com.apple.security.application-groups</key>
		<array>
			<string>group.com.gilad.shadchan</string>
		</array>
		<!-- Sign in with Apple. Required by App Store review wherever a
		     third-party sign-in (Google) is offered, and what makes
		     AppleAuthProvider use Apple's own sheet rather than a web flow.
		     It also has to be enabled for this App ID in the Apple Developer
		     portal, and the Apple provider switched on in the Firebase
		     console — neither of which lives in this repository. -->
		<key>com.apple.developer.applesignin</key>
		<array>
			<string>Default</string>
		</array>
	</dict>
</plist>
