# The web app's registration in Firebase project shadchan-gilad
# (Firebase console → Project settings → Your apps → the Web app).
# These are public values; set them in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check site key (Firestore and Storage enforce App Check). One of:
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_RECAPTCHA_V3_KEY=
# Local testing against the Firebase emulators only.
# NEXT_PUBLIC_USE_EMULATORS=1
