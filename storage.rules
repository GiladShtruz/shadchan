rules_version = '2';

// The candidates' photos. Same rule as firestore.rules, and for a stronger
// reason: a readable photo URL is a face, and these are faces of people who
// gave them to a matchmaker in confidence.
//
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/photos/{fileName} {
      function isOwner() {
        return request.auth != null
            && request.auth.uid == userId
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read, delete: if isOwner();

      // A 12MB ceiling and an image content type, so a bug or a misuse cannot
      // turn the bucket into general-purpose storage. Photos reaching here have
      // already been through the picker and the editor and are far under this.
      allow write: if isOwner()
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Screenshots attached to a problem report. Named after the report they
    // belong to, so the file and the words cannot drift apart.
    //
    // Write is open to any signed-in device, anonymous included, matching the
    // `supportReports` rule in `firestore.rules` — the report is the thing
    // being allowed, and a report with its screenshot silently dropped is worse
    // than no report. Read is the administrators', checked against the same
    // Firestore list the console uses, so adding a reviewer stays a one-line
    // change in one place.
    match /supportReports/{fileName} {
      function supportEmail() {
        return request.auth != null
            && request.auth.token.get('email_verified', false) == true
               ? request.auth.token.get('email', '').lower()
               : '';
      }

      function isSupportAdmin() {
        return supportEmail() != ''
            && (supportEmail() == 'yitz292@gmail.com'
                || firestore.exists(/databases/(default)/documents/supportAdmins/$(supportEmail())));
      }

      allow read, delete: if isSupportAdmin();

      // One screenshot, an image, under 12MB — the same ceiling the candidate
      // photos have, and for the same reason: a bug here must not turn the
      // bucket into general-purpose storage.
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // A published couple's photograph used to live at
    // `communityEngagements/{userId}/{fileName}`. The feature that wrote it —
    // publishing a couple's first names and picture on the strength of the
    // matchmaker ticking a consent box — was removed, and the path is removed
    // with it rather than left open and unused. It now falls to the catch-all
    // at the bottom of this file, which refuses everything.
    //
    // Files uploaded before the removal are still in the bucket and should be
    // deleted from the Firebase console.

    // A matchmaker's own picture, drawn beside their name on the leaderboard.
    //
    // The second readable path in this bucket, and the narrower of the two: it
    // is one file per account, named by the uid in the path, and it can only
    // ever be the account holder's own face. **No candidate's photo can reach
    // here** — the app uploads only `UserProfileProvider.photoPath`, the
    // picture the matchmaker chose for themselves during onboarding.
    //
    // It is published under the same consent as the name: the app clears the
    // Firestore field and deletes this file the moment somebody hides
    // themselves, goes private, or removes their photo. Read is open to
    // signed-in devices because the board is shown to all of them.
    match /communityMembers/{userId}/{fileName} {
      function isOwner() {
        return request.auth != null
            && request.auth.uid == userId
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read: if request.auth != null;
      allow delete: if isOwner();

      // One image, well under the ceiling the rest of the bucket uses.
      allow write: if isOwner()
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
