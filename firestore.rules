rules_version = '2';

// Every matchmaker's database is private to their own account, full stop.
//
// The data behind these rules is other people's names, ages, phone numbers and
// private notes about their shidduchim — collected by a matchmaker who was
// trusted with it, not published by the candidates themselves. There is no
// sharing feature, no admin view and no cross-user query anywhere in the app,
// so there is no reason for any rule here to be wider than "your own uid".
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // An anonymous account must never own a backup. It dies with the
      // install, so data written under one is unrecoverable — and the app
      // refuses to sync under one for the same reason (CloudSyncService
      // ._requireAccount). Enforced here too, because a client-side rule is
      // not a rule.
      function isOwner() {
        return request.auth != null
            && request.auth.uid == userId
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read, write: if isOwner();

      // The four record collections. Named explicitly rather than matched with
      // a wildcard so a future collection has to be considered before it can
      // be written.
      match /people/{personId} {
        allow read, write: if isOwner();
      }
      match /personNotes/{noteId} {
        allow read, write: if isOwner();
      }
      match /matches/{matchId} {
        allow read, write: if isOwner();
      }
      match /matchNotes/{noteId} {
        allow read, write: if isOwner();
      }

      // The matchmaker's own profile — one document, `main`.
      match /profile/{documentId} {
        allow read, write: if isOwner();
      }
    }

    // Who may run the feedback console — and, with it, approve a tip. The root
    // address is written here, and everybody else is a document in
    // `supportAdmins` keyed by their own address, which is the whole point:
    // adding a reviewer must not need a new build of the app. `email_verified`
    // closes the door on an unverified address claiming to be one of them, and
    // `get` with a default is used because an anonymous token carries no email
    // field at all.
    function supportEmail() {
      return request.auth != null
          && request.auth.token.get('email_verified', false) == true
             ? request.auth.token.get('email', '').lower()
             : '';
    }

    function isSupportAdmin() {
      return supportEmail() != ''
          && (supportEmail() == 'yitz292@gmail.com'
              || exists(/databases/$(database)/documents/supportAdmins/$(supportEmail())));
    }

    // The one deliberately shared collection in the app: tips written by a
    // matchmaker for every other matchmaker. Nothing about a candidate is in
    // here — the only personal field is the author's own name, which they put
    // there themselves.
    match /tips/{tipId} {
      // Who may approve a tip: exactly the people who may open the feedback
      // console, because approving tips is one of the things done there. That
      // is the root address plus whoever is listed in `supportAdmins` — decided
      // on the server from a verified token, never from the client. See
      // `isSupportAdmin()` above.
      function isAdmin() {
        return isSupportAdmin();
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Approved tips are readable by every signed-in device, anonymous ones
      // included — a matchmaker who never connected an account still gets the
      // community's tips. Beyond that you may read only your own submissions.
      allow read: if isSignedIn()
                  && (resource.data.status == 'approved'
                      || resource.data.authorUid == request.auth.uid
                      || isAdmin());

      // Writing one needs a durable account, for the same reason a backup does:
      // an anonymous uid dies with the install, and a tip credited to nobody
      // cannot be reviewed, corrected or withdrawn. Every new tip starts
      // pending — a client cannot publish straight into the rotation.
      allow create: if isSignedIn()
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 80;

      // Approval, rejection and removal are the administrator's alone.
      allow update, delete: if isAdmin();
    }

    // --- Support -----------------------------------------------------------

    // Problem reports and improvement ideas.
    //
    // Anyone signed in may write one, **anonymous accounts included**: most
    // matchmakers never connect an account, and a product that only hears from
    // the ones who did is hearing from the wrong ones. Nobody may read the
    // collection except an administrator — a report is one person's words about
    // their own use of the app, and there is no reason for another user to see
    // it. A reporter cannot read back even their own, which is deliberate:
    // making it readable would mean a query anyone could run.
    match /supportReports/{reportId} {
      allow read, update, delete: if isSupportAdmin();

      // The three facts a report carries about the phone it came from, and the
      // path to its screenshot. Short strings every one of them — "Samsung
      // SM-G991B", "Android 14", "1.4.2+87", and a bucket path built from the
      // report's own id.
      //
      // Capped because they were the only fields on this document that nothing
      // checked. `text` and `authorName` have had ceilings from the start, so
      // a client wanting to push a megabyte into the console simply put it in
      // `device` instead — a field the reviewer's screen renders and nobody
      // ever looks at closely.
      function fact(data, field, ceiling) {
        return !(field in data)
            || (data[field] is string && data[field].size() <= ceiling);
      }

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['text', 'authorName', 'authorUid', 'device', 'os',
                          'appVersion', 'status', 'kind', 'createdAt',
                          'imagePath'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'isNew'
                    // The server's clock, so the console can order by it. The
                    // report list is `orderBy('createdAt')` under a limit, and
                    // a document without the field is left out of that query
                    // altogether — a report that could never be read.
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 3000
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 80
                    && fact(request.resource.data, 'device', 200)
                    && fact(request.resource.data, 'os', 100)
                    && fact(request.resource.data, 'appVersion', 100)
                    // A path inside our own bucket, never a URL. See
                    // `SupportService._uploadScreenshot` for why a download URL
                    // must never be stored: it carries a permanent token that
                    // bypasses `storage.rules` entirely.
                    && fact(request.resource.data, 'imagePath', 300)
                    // Optional, and only ever one of the four labels the form
                    // offers — a free-text field here would be a way to write
                    // unvalidated strings into the console.
                    && (!('kind' in request.resource.data)
                        || request.resource.data.kind in
                             ['idea', 'note', 'bug', 'unsorted']);
    }

    // The administrator list itself. Writable only by the root address, so an
    // administrator cannot promote themselves a colleague — or remove the
    // person who appointed them.
    //
    // Reading is split, because the two callers want different things and only
    // one of them is an administrator. `SupportService.isAdmin` fetches the one
    // document named after the reader's own address to decide whether to draw
    // the console entry — that is a `get`, and it is allowed against your own
    // address and nobody else's. `SupportService.fetchAdmins` lists the whole
    // collection to populate the console's reviewer list, and that is a `list`
    // only an administrator may run.
    //
    // The distinction is not cosmetic: `read` covered both, which meant every
    // installed copy of the app could download the email address of every
    // person who reviews reports. That is a set of real people's personal
    // addresses, published to an audience that has no use for it.
    match /supportAdmins/{adminEmail} {
      allow get: if supportEmail() != ''
                 && (adminEmail == supportEmail() || isSupportAdmin());
      allow list: if isSupportAdmin();
      allow write: if supportEmail() == 'yitz292@gmail.com';
    }

    // "מה חדש?" — read by every signed-in device on app open, written by an
    // administrator. Public by construction: it is an announcement.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();
    }

    // --- The community -----------------------------------------------------
    //
    // The one place in this database where a user's own row is readable by
    // other users, and the exception is deliberate and narrow. A member
    // document holds a name the matchmaker typed about *themselves* and a row
    // of counters — an activity score per window, and how many friends, ideas,
    // couples and engagements are behind it. It holds nothing about a
    // candidate: no person, no proposal, no note, no photo, no phone number —
    // those never leave `users/{uid}`.
    //
    // `communityGoals` used to sit below this: a shared weekly target the
    // community aimed at. The feature was removed, and its rule with it, so
    // the collection is closed by the catch-all at the bottom.
    //
    // Read is open to any signed-in device because it has to be: the
    // leaderboard is a sorted query and the community totals are `sum()` /
    // `count()` aggregates, and neither can run against documents the caller
    // may not read. Write is the owner's alone, so nobody can put words in
    // anybody's mouth or push themselves up the board.
    match /communityMembers/{uid} {
      // A counter, if the write carries one at all.
      //
      // **This is the only thing standing between the community figures and
      // one hand-rolled client.** The totals are `sum()` aggregates over this
      // collection, so a single member document claiming 9e18 friends does not
      // merely top the leaderboard — it becomes "what the community did this
      // week" for every matchmaker in the app, and no client can tell that the
      // number is wrong. An integer, never negative, and under a ceiling far
      // above anything a real matchmaker reaches but far below anything that
      // could overflow or dominate a sum.
      //
      // Absence is allowed on purpose: `setHidden` writes three fields with
      // `merge: true`, and on a document that does not exist yet the counters
      // are simply not part of the write.
      function counter(data, field) {
        return !(field in data)
            || (data[field] is int
                && data[field] >= 0
                && data[field] <= 10000000);
      }

      // A period key — `2026-08-21`, `W2026-08-16`, `2026-08`. Compared for
      // equality only, so the only thing worth checking is that it is a short
      // string rather than a document's worth of text.
      function periodKey(data, field) {
        return !(field in data)
            || (data[field] is string && data[field].size() <= 16);
      }

      function windowOk(data, prefix) {
        return counter(data, prefix + 'Actions')
            && counter(data, prefix + 'Friends')
            && counter(data, prefix + 'Ideas')
            && counter(data, prefix + 'Couples')
            && counter(data, prefix + 'Engagements');
      }

      function countsOk(data) {
        return windowOk(data, 'day')
            && windowOk(data, 'week')
            && windowOk(data, 'month')
            && windowOk(data, 'all')
            && periodKey(data, 'dayKey')
            && periodKey(data, 'weekKey')
            && periodKey(data, 'monthKey');
      }

      // Nothing but the vocabulary above. A whitelist rather than a blacklist
      // because this collection is world-readable to every installed copy of
      // the app: an unlisted field is a place for a client to write whatever
      // it likes and have every other device read it.
      function noStrayFields(data) {
        return data.keys().hasOnly([
          'name', 'photoUrl', 'hidden', 'updatedAt',
          'dayKey', 'dayActions', 'dayFriends', 'dayIdeas', 'dayCouples',
          'dayEngagements',
          'weekKey', 'weekActions', 'weekFriends', 'weekIdeas', 'weekCouples',
          'weekEngagements',
          'monthKey', 'monthActions', 'monthFriends', 'monthIdeas',
          'monthCouples', 'monthEngagements',
          'allActions', 'allFriends', 'allIdeas', 'allCouples',
          'allEngagements'
        ]);
      }

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 80
                            && request.resource.data.hidden is bool
                            // The matchmaker's own picture, drawn beside their
                            // name on the board. A URL and nothing else; the
                            // file itself lives under the same uid in Storage
                            // and is governed by `storage.rules`.
                            && (!('photoUrl' in request.resource.data)
                                || (request.resource.data.photoUrl is string
                                    && request.resource.data.photoUrl.size() <= 500))
                            && countsOk(request.resource.data)
                            && noStrayFields(request.resource.data);

      // Erasure, from the button on "פרטיות והמאגר שלי". Split out because a
      // delete carries no `request.resource`, so the field checks above would
      // refuse it — which would have left the app promising a deletion it could
      // not perform.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- "מזל טוב! זוג חדש התארס!" ----------------------------------------
    //
    // **No candidate's name can be written here, by anybody, ever.**
    //
    // There used to be a way: the app offered to publish a couple's first names
    // and a photograph, and the rule below let it through on a `coupleApproved`
    // flag the matchmaker ticked. The feature is gone, and the rule that
    // permitted it is gone with it — a permission nothing uses is a permission
    // waiting to be used by mistake.
    //
    // A record says that a wedding happened, when, whose account marked it, and
    // that account's own proposal id. Optionally the matchmaker's own name,
    // which they are asked about per wedding. That is the whole vocabulary, and
    // `firstNames` and `photoUrl` are refused outright rather than merely
    // unwritten, so an older build or a hand-rolled client cannot put one back.
    //
    // **Read is open to any signed-in device**, because the announcement is a
    // query over documents the reader does not own. Write, update and delete
    // are the author's alone.
    match /communityEngagements/{engagementId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Everything the app ever writes here, and nothing else.
      function wellFormed(data) {
        return data.keys().hasOnly(
                 ['authorUid', 'createdAt', 'expiresAt', 'matchmakerName',
                  'matchId'])
            && data.authorUid is string
            && data.matchmakerName is string
            && data.matchmakerName.size() <= 80
            && data.matchId is string
            && data.matchId.size() <= 64
            // When the TTL sweep will delete this. Required, so a record
            // cannot be written that outlives the policy, and refused if it is
            // already past — a client must not be able to plant a record that
            // disappears before anybody reads it, nor one dated so far out
            // that "nothing here is ever a history" stops being true.
            && data.expiresAt is timestamp
            && data.expiresAt > request.time
            && data.expiresAt < request.time + duration.value(60, 'd');
      }

      // Naming yourself needs a durable account: a name published under a uid
      // that dies with the install could never afterwards be withdrawn by the
      // person who put it there.
      function namedOnlyByDurableAccount(data) {
        return data.matchmakerName == ''
            || request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read: if isSignedIn();

      // `createdAt` must be the server's own clock, not the client's.
      //
      // Every reader sorts this collection by it and shows the newest record,
      // and the whole feature rests on a record ageing out after a week. A
      // client-chosen timestamp is therefore not a detail: one dated to the
      // year 3000 would sit at the top of every matchmaker's home screen and
      // never expire, and one dated to the past would be born invisible.
      // `request.time` is exactly what `FieldValue.serverTimestamp()` resolves
      // to, so the app already satisfies this.
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && wellFormed(request.resource.data)
                    && namedOnlyByDurableAccount(request.resource.data);

      // The author attaches or removes their own name afterwards. The author
      // may never change, so an update cannot move a record onto somebody
      // else's account — and neither the age nor the proposal id may change,
      // so an update cannot refresh a record to the top of the feed or
      // redirect other people's brachot into a different journal. Only
      // `matchmakerName` is left free, which is the whole reason update exists.
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.matchId == resource.data.matchId
                    && wellFormed(request.resource.data)
                    && namedOnlyByDurableAccount(request.resource.data);

      // Split out because a delete carries no `request.resource` and the checks
      // above would refuse it.
      allow delete: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    // --- "שלחו מזל טוב" ----------------------------------------------------
    //
    // Addressed post between two matchmakers, and the narrowest collection in
    // this database.
    //
    // **A message is readable only by the person it was sent to.** Not by the
    // sender, not by anybody else, and there is no query anywhere that could
    // list somebody else's. That single rule is what lets these documents carry
    // a proposal id at all: it is meaningless without the recipient's own
    // database, and nobody but the recipient can ever read it.
    //
    // **Nothing about a candidate may be in here.** The sender is answering an
    // announcement that says "a couple got married" and knows no more than
    // that; what they write is a bracha and their own name.
    //
    // **The recipient empties their own postbox.** The app files each message
    // into the local journal and then deletes it, so this collection holds only
    // undelivered post and never becomes a history of who said what to whom.
    match /communityMazelTov/{messageId} {
      function isSignedIn() {
        return request.auth != null
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;

      // Create only — a bracha cannot be edited after it is sent, which is
      // what makes "who wrote this" answerable at all.
      // `createdAt` is required and must be the server's clock. The postbox is
      // drained by `toUid == me` **ordered by `createdAt`**, and Firestore
      // leaves a document without the ordered field out of the result set
      // entirely — so a message created without one is undeliverable *and*
      // uncollectable, and sits against the recipient's uid for ever. The
      // ordering is also what makes "oldest first" true, which a client-chosen
      // timestamp could quietly break.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['toUid', 'fromUid', 'fromName', 'matchId', 'text',
                          'createdAt', 'expiresAt'])
                    && request.resource.data.createdAt == request.time
                    // When the TTL sweep clears an uncollected message. The
                    // recipient normally deletes it long before; this is what
                    // stops post addressed to somebody who never comes back
                    // from sitting here for ever.
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt
                         < request.time + duration.value(120, 'd')
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.matchId is string
                    && request.resource.data.matchId.size() > 0
                    && request.resource.data.matchId.size() <= 64
                    && request.resource.data.fromName is string
                    && request.resource.data.fromName.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 200;

      allow update: if false;

      // The recipient clears their own, once it is safely in their journal.
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // Anything not named above is closed. Without this, a path added later
    // starts life world-readable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
