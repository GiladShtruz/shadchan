rules_version = '2';

// Every matchmaker's database is private to their own account, full stop.
// The one deliberate exception is the personal card near the end of this file:
// a card its *owner* writes and shares with the matchmakers they approve.
//
// The data behind these rules is other people's names, ages, phone numbers and
// private notes about their shidduchim — collected by a matchmaker who was
// trusted with it, not published by the candidates themselves. There is no
// sharing feature, no admin view and no cross-user query anywhere in the app,
// so there is no reason for any rule here to be wider than "your own uid".
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function membershipPath(uid) { return /databases/$(database)/documents/memberships/$(uid); }
    function paired() { return exists(membershipPath(request.auth.uid)); }
    function databaseUid() { return paired() ? get(membershipPath(request.auth.uid)).data.databaseUid : request.auth.uid; }
    function databaseMember(uid) {
      return durable() && (paired()
        ? get(membershipPath(request.auth.uid)).data.databaseUid == uid && get(membershipPath(request.auth.uid)).data.state == 'active'
        : request.auth.uid == uid);
    }
    function databaseWrite(uid) {
      return databaseMember(uid) && (!paired() || request.resource.data._actorUid == request.auth.uid);
    }
    function sharedSetting(key) { return key.matches('^(home[.]board.*|tags[.].*|tagLibrary|suggestionDismiss.*|cardSyncRemote[.].*|deletedIdeas.*)$'); }
    match /memberships/{uid} { allow read: if durable() && request.auth.uid == uid; allow write: if false; }
    match /couples/{uid} {
      allow read: if durable() && request.auth.uid in resource.data.members;
      allow write: if false;
    }
    match /coupleData/{workspaceId} {
      function member() {
        return durable() && paired() && get(membershipPath(request.auth.uid)).data.operation == workspaceId
          && get(membershipPath(request.auth.uid)).data.state == 'active';
      }
      allow read, write: if false;
      match /inbox/{id} {
        allow read, delete: if member();
        allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }
      match /settings/{id} {
        allow read: if member();
        allow write: if member() && request.resource.data._actorUid == request.auth.uid
          && (request.resource.data.get('_deleted', false) || sharedSetting(request.resource.data.k));
      }
    }
    match /coupleInvites/{id} { allow read, write: if false; }
    match /coupleArchives/{path=**} { allow read, write: if false; }

    match /users/{userId} {
      // An anonymous account must never own a backup. It dies with the
      // install, so data written under one is unrecoverable — and the app
      // refuses to sync under one for the same reason (CloudSyncService
      // ._requireAccount). Enforced here too, because a client-side rule is
      // not a rule.
      function isOwner() {
        return request.auth != null
            && request.auth.uid == userId
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read: if isOwner();
      allow write: if isOwner() && (!paired() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletion']));

      // The record collections. Named explicitly rather than matched with a
      // wildcard so a future collection has to be considered before it can be
      // written. Each document carries the record, or `_deleted: true` for a
      // tombstone, plus `_w` (server time of the write) and `_d` (the device),
      // which is how every phone signed in to the account keeps in step — see
      // `AccountSyncEngine`.
      //
      // The root document itself holds `deletion: {requestedAt, purgeAfter}`
      // while the account is in its 30 days of grace; `purgeDeletedAccounts`
      // erases the whole tree after that.
      match /people/{personId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }
      match /personNotes/{noteId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }
      match /matches/{matchId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }
      match /matchNotes/{noteId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }

      // The two history ledgers behind the profile history feeds and the
      // activity figures. Local-only until signing out began deleting the
      // local database — at which point "it is only a local ledger" stopped
      // being true, and losing them would have silently reset a matchmaker's
      // whole record of their own work.
      match /personEvents/{eventId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }
      match /matchStatusEvents/{eventId} {
        allow read: if databaseMember(userId);
        allow create, update: if databaseWrite(userId);
        allow delete: if durable() && !paired() && request.auth.uid == userId;
      }

      // The matchmaker's own profile — one document, `main`. Written by
      // versions before the account sync; read once by the sync to fill an
      // account that has no synced profile yet.
      match /profile/{documentId} {
        allow read, write: if isOwner();
      }

      // Everything else the account holds that is not a record: the profile,
      // the board, reminders, dismissed suggestions, tags, preferences — one
      // document per setting, `{k: key, v: JSON}` (`AccountSyncCodec`). Kept
      // in step across the account's phones like the records are.
      match /settings/{documentId} {
        allow read, write: if isOwner();
      }

      // The losing version of a record two devices edited at once
      // (`AccountSyncEngine._keepConflict`) — kept, not discarded, so support
      // can restore it. Written and read by the account only.
      match /syncConflicts/{conflictId} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
            && request.resource.data.keys().hasOnly(
                 ['collection', 'recordId', 'lostSide', 'device', 'kept', 'lost', 'at'])
            && request.resource.data.collection is string
            && request.resource.data.recordId is string;
        allow update: if false;
      }

      // News addressed to this account — an access request, an answer, a
      // friend's wedding or birthday. Written only by Cloud Functions (which
      // bypass these rules), read and cleared by the account itself.
      match /inbox/{itemId} {
        allow read, update, delete: if isOwner();
        allow create: if false;
      }

      // What the server worked out for this account and only this account —
      // `helpers`: the matchmakers among a card owner's contacts. Written by
      // Cloud Functions, which can see the phone directory whole; the client
      // never can.
      match /private/{documentId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // Who may run the feedback console — and, with it, approve a tip. The root
    // address is written here, and everybody else is a document in
    // `supportAdmins` keyed by their own address, which is the whole point:
    // adding a reviewer must not need a new build of the app. `email_verified`
    // closes the door on an unverified address claiming to be one of them, and
    // `get` with a default is used because an anonymous token carries no email
    // field at all.
    function supportEmail() {
      return request.auth != null
          && request.auth.token.get('email_verified', false) == true
             ? request.auth.token.get('email', '').lower()
             : '';
    }

    function isSupportAdmin() {
      return supportEmail() != ''
          && (supportEmail() == 'yitz292@gmail.com'
              || exists(/databases/$(database)/documents/supportAdmins/$(supportEmail())));
    }

    // The one deliberately shared collection in the app: tips written by a
    // matchmaker for every other matchmaker. Nothing about a candidate is in
    // here — the only personal field is the author's own name, which they put
    // there themselves.
    match /tips/{tipId} {
      // Who may approve a tip: exactly the people who may open the feedback
      // console, because approving tips is one of the things done there. That
      // is the root address plus whoever is listed in `supportAdmins` — decided
      // on the server from a verified token, never from the client. See
      // `isSupportAdmin()` above.
      function isAdmin() {
        return isSupportAdmin();
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Approved tips are readable by every signed-in device, anonymous ones
      // included — a matchmaker who never connected an account still gets the
      // community's tips. Beyond that you may read only your own submissions.
      allow read: if isSignedIn()
                  && (resource.data.status == 'approved'
                      || resource.data.authorUid == request.auth.uid
                      || isAdmin());

      // Writing one needs a durable account, for the same reason a backup does:
      // an anonymous uid dies with the install, and a tip credited to nobody
      // cannot be reviewed, corrected or withdrawn. Every new tip starts
      // pending — a client cannot publish straight into the rotation.
      allow create: if isSignedIn()
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 80;

      // Approval and rejection are the administrator's alone. The author may
      // remove their own submission — including during account deletion — but
      // can never edit an approved tip into different words afterwards.
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.authorUid == request.auth.uid);
    }

    // --- Support -----------------------------------------------------------

    // Problem reports and improvement ideas.
    //
    // Anyone signed in may write one, **anonymous accounts included**: most
    // matchmakers never connect an account, and a product that only hears from
    // the ones who did is hearing from the wrong ones. Nobody may read the
    // collection except an administrator — a report is one person's words about
    // their own use of the app, and there is no reason for another user to see
    // it. A reporter cannot read back even their own, which is deliberate:
    // making it readable would mean a query anyone could run.
    match /supportReports/{reportId} {
      function isReporter() {
        return request.auth != null
            && resource.data.authorUid == request.auth.uid;
      }

      // An administrator sees everything. **The person who sent a report can
      // now read that report back, and only that report** — `authorUid ==
      // me`, which is also what makes the reporter's own query
      // (`SupportService.fetchMyReports`) legal and keeps it from being a way
      // to list anybody else's.
      //
      // This is new, and it is what the conversation feature costs. It buys
      // the thing the old design could not do at all: answer somebody. Most
      // accounts here are anonymous and carry no address, so before this an
      // administrator reading "the button does nothing" had no way on earth to
      // ask which button.
      allow read: if isSupportAdmin() || isReporter();
      allow delete: if isSupportAdmin();

      // Filing a report — status, reviewer stamp, anything — is the
      // administrator's. The reporter may touch exactly the two fields that
      // record that their own message was the last one, and nothing else: they
      // cannot mark their own report "טופל", re-word it, or change who sent
      // it. `lastMessageFromAdmin` is forced false on their side, so a report
      // cannot be made to look answered by the person waiting for an answer.
      allow update: if isSupportAdmin()
                    || (isReporter()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['lastMessageAt', 'lastMessageFromAdmin'])
                        && request.resource.data.lastMessageAt == request.time
                        && request.resource.data.lastMessageFromAdmin == false);

      // The three facts a report carries about the phone it came from, and the
      // path to its screenshot. Short strings every one of them — "Samsung
      // SM-G991B", "Android 14", "1.4.2+87", and a bucket path built from the
      // report's own id.
      //
      // Capped because they were the only fields on this document that nothing
      // checked. `text` and `authorName` have had ceilings from the start, so
      // a client wanting to push a megabyte into the console simply put it in
      // `device` instead — a field the reviewer's screen renders and nobody
      // ever looks at closely.
      function fact(data, field, ceiling) {
        return !(field in data)
            || (data[field] is string && data[field].size() <= ceiling);
      }

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['text', 'authorName', 'authorUid', 'device', 'os',
                          'appVersion', 'status', 'kind', 'createdAt',
                          'imagePath'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'isNew'
                    // The server's clock, so the console can order by it. The
                    // report list is `orderBy('createdAt')` under a limit, and
                    // a document without the field is left out of that query
                    // altogether — a report that could never be read.
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 3000
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 80
                    && fact(request.resource.data, 'device', 200)
                    && fact(request.resource.data, 'os', 100)
                    && fact(request.resource.data, 'appVersion', 100)
                    // A path inside our own bucket, never a URL. See
                    // `SupportService._uploadScreenshot` for why a download URL
                    // must never be stored: it carries a permanent token that
                    // bypasses `storage.rules` entirely.
                    && fact(request.resource.data, 'imagePath', 300)
                    // Optional, and only ever one of the four labels the form
                    // offers — a free-text field here would be a way to write
                    // unvalidated strings into the console.
                    && (!('kind' in request.resource.data)
                        || request.resource.data.kind in
                             ['idea', 'note', 'bug', 'unsorted']);

      // The conversation hanging off one report: the administrator asking for
      // details, and the person who sent it answering.
      //
      // **Exactly two people can see a thread** — an administrator, and the
      // account that wrote the report it belongs to. The reporter is
      // recognised through the parent document, which is the only place that
      // fact is written and one nobody but an administrator can change.
      //
      // `fromAdmin` is claimed by the client and checked here: a message can
      // only say it came from the app's own team if the verified token behind
      // it belongs to that team. Without this, anybody could write themselves
      // an official-looking answer — in their own thread only, but still.
      //
      // Messages are append-only. An answered question that can be edited
      // afterwards is not a record of anything.
      match /messages/{messageId} {
        function reportAuthorUid() {
          return get(/databases/$(database)/documents/supportReports/$(reportId))
                   .data.authorUid;
        }

        function inMyThread() {
          return request.auth != null && reportAuthorUid() == request.auth.uid;
        }

        allow read: if isSupportAdmin() || inMyThread();

        allow create: if (isSupportAdmin() || inMyThread())
                      && request.resource.data.keys().hasOnly(
                           ['text', 'fromAdmin', 'authorUid', 'authorName',
                            'createdAt'])
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1500
                      && request.resource.data.fromAdmin is bool
                      && (request.resource.data.fromAdmin == false
                          || isSupportAdmin())
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() <= 80;

        allow update, delete: if false;
      }
    }

    // The administrator list itself. Writable only by the root address, so an
    // administrator cannot promote themselves a colleague — or remove the
    // person who appointed them.
    //
    // Reading is split, because the two callers want different things and only
    // one of them is an administrator. `SupportService.isAdmin` fetches the one
    // document named after the reader's own address to decide whether to draw
    // the console entry — that is a `get`, and it is allowed against your own
    // address and nobody else's. `SupportService.fetchAdmins` lists the whole
    // collection to populate the console's reviewer list, and that is a `list`
    // only an administrator may run.
    //
    // The distinction is not cosmetic: `read` covered both, which meant every
    // installed copy of the app could download the email address of every
    // person who reviews reports. That is a set of real people's personal
    // addresses, published to an audience that has no use for it.
    match /supportAdmins/{adminEmail} {
      allow get: if supportEmail() != ''
                 && (adminEmail == supportEmail() || isSupportAdmin());
      allow list: if isSupportAdmin();
      allow write: if supportEmail() == 'yitz292@gmail.com';
    }

    // "מה חדש?" — read by every signed-in device on app open, written by an
    // administrator. Public by construction: it is an announcement.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();
    }

    // Personal-area announcements are public to signed-in members only after
    // publication. Drafts and all mutations belong to verified administrators.
    match /personalNews/{id} {
      allow read: if durable() && (resource.data.published == true || isSupportAdmin());
      allow create, update: if isSupportAdmin()
        && request.resource.data.keys().hasOnly(['title', 'text', 'imagePath', 'published', 'notify', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && request.resource.data.published is bool && request.resource.data.notify is bool
        && (request.resource.data.imagePath == null ||
          (request.resource.data.imagePath is string && request.resource.data.imagePath.matches('personalNews/' + id + '/[A-Za-z0-9_.-]+')))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSupportAdmin();
    }
    match /matchmakerActivity/{uid} {
      // Yourself; a card owner who gave this matchmaker access; and, for
      // "שדכנים שאני מכיר", a matchmaker who has [uid] saved in their phone
      // or who shares with them (or asked to) either way.
      allow get: if durable() && (uid == request.auth.uid ||
        (exists(accessPath(request.auth.uid, uid)) && get(accessPath(request.auth.uid, uid)).data.status == 'approved' && get(accessPath(request.auth.uid, uid)).data.get('cardGranted', true) == true) ||
        exists(shareRowPath(request.auth.uid, uid)) || exists(shareRowPath(uid, request.auth.uid)) ||
        knownPhoneInContacts(request.auth.uid, uid));
      allow list: if false;
      allow create, update: if durable() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['databaseCount', 'lastActiveAt'])
        && request.resource.data.databaseCount is int && request.resource.data.databaseCount >= 0 && request.resource.data.databaseCount <= 1000000
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if durable() && uid == request.auth.uid;
    }
    match /personalInvites/{id} {
      allow read: if durable() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /personalNudges/{id} { allow read, write: if false; }

    // --- The community -----------------------------------------------------
    //
    // The one place in this database where a user's own row is readable by
    // other users, and the exception is deliberate and narrow. A member
    // document holds a name the matchmaker typed about *themselves* and a row
    // of counters — an activity score per window, and how many friends, ideas,
    // couples and engagements are behind it. It holds nothing about a
    // candidate: no person, no proposal, no note, no photo, no phone number —
    // those never leave `users/{uid}`.
    //
    // The administrators' dashboard: counts only, written by the server
    // (`refreshAdminStats`), read by support administrators and nobody else.
    match /adminStats/{document=**} {
      allow read: if isSupportAdmin();
      allow write: if false;
    }

    // Shared home-page goal. A verified administrator chooses the public
    // heading, metric and target; every signed-in member observes this one doc.
    match /communityGoals/weekly {
      allow read: if request.auth != null;
      allow create, update: if isSupportAdmin()
        && request.resource.data.keys().hasAll(['metric', 'target', 'title', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['metric', 'target', 'title', 'updatedAt'])
        && request.resource.data.metric in ['ideas', 'friends', 'couples']
        && request.resource.data.target is int
        && request.resource.data.target > 0
        && request.resource.data.target <= 1000000
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Read is open to any signed-in device because it has to be: the
    // leaderboard is a sorted query and the community totals are `sum()` /
    // `count()` aggregates, and neither can run against documents the caller
    // may not read. Write is the owner's alone, so nobody can put words in
    // anybody's mouth or push themselves up the board.
    match /communityMembers/{uid} {
      // A counter, if the write carries one at all.
      //
      // **This is the only thing standing between the community figures and
      // one hand-rolled client.** The totals are `sum()` aggregates over this
      // collection, so a single member document claiming 9e18 friends does not
      // merely top the leaderboard — it becomes "what the community did this
      // week" for every matchmaker in the app, and no client can tell that the
      // number is wrong. An integer, never negative, and under a ceiling far
      // above anything a real matchmaker reaches but far below anything that
      // could overflow or dominate a sum.
      //
      // Absence is allowed on purpose: `setHidden` writes three fields with
      // `merge: true`, and on a document that does not exist yet the counters
      // are simply not part of the write.
      function counter(data, field) {
        return !(field in data)
            || (data[field] is int
                && data[field] >= 0
                && data[field] <= 10000000);
      }

      // A period key — `2026-08-21` for the day, `W2026-08-16` for the week
      // (its Sunday, the midnight מוצאי שבת turns over on), and `H5786-11` for
      // the month, which is the Hebrew one from Rosh Chodesh to Rosh Chodesh.
      // Compared for equality only, so the only thing worth checking is that
      // it is a short string rather than a document's worth of text.
      function periodKey(data, field) {
        return !(field in data)
            || (data[field] is string && data[field].size() <= 16);
      }

      function windowOk(data, prefix) {
        return counter(data, prefix + 'Actions')
            && counter(data, prefix + 'Friends')
            && counter(data, prefix + 'Ideas')
            && counter(data, prefix + 'Couples')
            && counter(data, prefix + 'Engagements');
      }

      function countsOk(data) {
        return windowOk(data, 'day')
            && windowOk(data, 'week')
            && windowOk(data, 'month')
            && windowOk(data, 'all')
            && periodKey(data, 'dayKey')
            && periodKey(data, 'weekKey')
            && periodKey(data, 'monthKey');
      }

      // The matchmaker's public page: a short line about themselves, the
      // handful of things they chose to tell other matchmakers, a benefit they
      // offer the community, and a number to reach them on. Every one of them
      // is optional, every one is typed in by hand, and every one is erased by
      // the same write that erases the name when somebody hides themselves —
      // so the only thing worth checking here is that they are short strings
      // rather than a payload. `shares` is a list of them, capped at one per
      // prompt on the client and at a round number here.
      function shortText(data, field, limit) {
        return !(field in data)
            || (data[field] is string && data[field].size() <= limit);
      }

      function shareList(data) {
        return !('shares' in data)
            || (data.shares is list && data.shares.size() <= 10);
      }

      function profileOk(data) {
        return shortText(data, 'about', 200)
            && shortText(data, 'benefit', 240)
            && shortText(data, 'contactPhone', 24)
            && shareList(data);
      }

      // The day this account joined the community, which is what
      // "שדכנים חדשים שהצטרפו לקהילה" counts. A timestamp or absent, and
      // nothing else: the client writes it once, with a server timestamp, on
      // the first publish that finds it missing. Absence has to be allowed
      // because every publish after that one carries no `joinedAt` at all,
      // and `setHidden` writes three fields on their own.
      function joinedAtOk(data) {
        return !('joinedAt' in data) || data.joinedAt is timestamp;
      }

      // Nothing but the vocabulary above. A whitelist rather than a blacklist
      // because this collection is world-readable to every installed copy of
      // the app: an unlisted field is a place for a client to write whatever
      // it likes and have every other device read it.
      function noStrayFields(data) {
        return data.keys().hasOnly([
          'name', 'photoUrl', 'hidden', 'updatedAt', 'joinedAt',
          'about', 'shares', 'benefit', 'contactPhone',
          'dayKey', 'dayActions', 'dayFriends', 'dayIdeas', 'dayCouples',
          'dayEngagements',
          'weekKey', 'weekActions', 'weekFriends', 'weekIdeas', 'weekCouples',
          'weekEngagements',
          'monthKey', 'monthActions', 'monthFriends', 'monthIdeas',
          'monthCouples', 'monthEngagements',
          'allActions', 'allFriends', 'allIdeas', 'allCouples',
          'allEngagements'
        ]);
      }

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && databaseMember(uid)
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 80
                            && request.resource.data.hidden is bool
                            // The matchmaker's own picture, drawn beside their
                            // name on the board. A URL and nothing else; the
                            // file itself lives under the same uid in Storage
                            // and is governed by `storage.rules`.
                            && (!('photoUrl' in request.resource.data)
                                || (request.resource.data.photoUrl is string
                                    && request.resource.data.photoUrl.size() <= 500))
                            && countsOk(request.resource.data)
                            && profileOk(request.resource.data)
                            && joinedAtOk(request.resource.data)
                            && noStrayFields(request.resource.data);

      // Erasure, from the button on "פרטיות והמאגר שלי". Split out because a
      // delete carries no `request.resource`, so the field checks above would
      // refuse it — which would have left the app promising a deletion it could
      // not perform.
      allow delete: if request.auth != null && databaseMember(uid);
    }

    // --- "מזל טוב! זוג חדש התארס!" ----------------------------------------
    //
    // **No candidate's name can be written here, by anybody, ever.**
    //
    // There used to be a way: the app offered to publish a couple's first names
    // and a photograph, and the rule below let it through on a `coupleApproved`
    // flag the matchmaker ticked. The feature is gone, and the rule that
    // permitted it is gone with it — a permission nothing uses is a permission
    // waiting to be used by mistake.
    //
    // A record says that a wedding happened, when, whose account marked it, and
    // that account's own proposal id. Optionally the matchmaker's own name,
    // which they are asked about per wedding. That is the whole vocabulary, and
    // `firstNames` and `photoUrl` are refused outright rather than merely
    // unwritten, so an older build or a hand-rolled client cannot put one back.
    //
    // **Read is open to any signed-in device**, because the announcement is a
    // query over documents the reader does not own. Write, update and delete
    // are the author's alone.
    match /communityEngagements/{engagementId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Everything the app ever writes here, and nothing else.
      function wellFormed(data) {
        return data.keys().hasOnly(
                 ['authorUid', 'createdAt', 'expiresAt', 'matchmakerName',
                  'matchId'])
            && data.authorUid is string
            && data.matchmakerName is string
            && data.matchmakerName.size() <= 80
            && data.matchId is string
            && data.matchId.size() <= 64
            // When the TTL sweep will delete this. Required, so a record
            // cannot be written that outlives the policy, and refused if it is
            // already past — a client must not be able to plant a record that
            // disappears before anybody reads it, nor one dated so far out
            // that "nothing here is ever a history" stops being true.
            && data.expiresAt is timestamp
            && data.expiresAt > request.time
            && data.expiresAt < request.time + duration.value(60, 'd');
      }

      // Naming yourself needs a durable account: a name published under a uid
      // that dies with the install could never afterwards be withdrawn by the
      // person who put it there.
      function namedOnlyByDurableAccount(data) {
        return data.matchmakerName == ''
            || request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      allow read: if isSignedIn();

      // `createdAt` must be the server's own clock, not the client's.
      //
      // Every reader sorts this collection by it and shows the newest record,
      // and the whole feature rests on a record ageing out after a week. A
      // client-chosen timestamp is therefore not a detail: one dated to the
      // year 3000 would sit at the top of every matchmaker's home screen and
      // never expire, and one dated to the past would be born invisible.
      // `request.time` is exactly what `FieldValue.serverTimestamp()` resolves
      // to, so the app already satisfies this.
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && wellFormed(request.resource.data)
                    && namedOnlyByDurableAccount(request.resource.data);

      // The author attaches or removes their own name afterwards. The author
      // may never change, so an update cannot move a record onto somebody
      // else's account — and neither the age nor the proposal id may change,
      // so an update cannot refresh a record to the top of the feed or
      // redirect other people's brachot into a different journal. Only
      // `matchmakerName` is left free, which is the whole reason update exists.
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.matchId == resource.data.matchId
                    && wellFormed(request.resource.data)
                    && namedOnlyByDurableAccount(request.resource.data);

      // Split out because a delete carries no `request.resource` and the checks
      // above would refuse it.
      allow delete: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    // --- "שלחו מזל טוב" ----------------------------------------------------
    //
    // Addressed post between two matchmakers, and the narrowest collection in
    // this database.
    //
    // **A message is readable only by the person it was sent to.** Not by the
    // sender, not by anybody else, and there is no query anywhere that could
    // list somebody else's. That single rule is what lets these documents carry
    // a proposal id at all: it is meaningless without the recipient's own
    // database, and nobody but the recipient can ever read it.
    //
    // **Nothing about a candidate may be in here.** The sender is answering an
    // announcement that says "a couple got married" and knows no more than
    // that; what they write is a bracha and their own name.
    //
    // **The recipient empties their own postbox.** The app files each message
    // into the local journal and then deletes it, so this collection holds only
    // undelivered post and never becomes a history of who said what to whom.
    match /communityMazelTov/{messageId} {
      function isSignedIn() {
        return request.auth != null
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      // The sender may read only their own outgoing documents so account
      // deletion can find and remove undelivered post. The app has no screen
      // that displays sent messages.
      allow read: if isSignedIn()
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);

      // Create only — a bracha cannot be edited after it is sent, which is
      // what makes "who wrote this" answerable at all.
      // `createdAt` is required and must be the server's clock. The postbox is
      // drained by `toUid == me` **ordered by `createdAt`**, and Firestore
      // leaves a document without the ordered field out of the result set
      // entirely — so a message created without one is undeliverable *and*
      // uncollectable, and sits against the recipient's uid for ever. The
      // ordering is also what makes "oldest first" true, which a client-chosen
      // timestamp could quietly break.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['toUid', 'fromUid', 'fromName', 'matchId', 'text',
                          'createdAt', 'expiresAt'])
                    && request.resource.data.createdAt == request.time
                    // When the TTL sweep clears an uncollected message. The
                    // recipient normally deletes it long before; this is what
                    // stops post addressed to somebody who never comes back
                    // from sitting here for ever.
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt
                         < request.time + duration.value(120, 'd')
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.matchId is string
                    && request.resource.data.matchId.size() > 0
                    && request.resource.data.matchId.size() <= 64
                    && request.resource.data.fromName is string
                    && request.resource.data.fromName.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 200;

      allow update: if false;

      // The recipient clears their own once it is safely in their journal; the
      // sender may withdraw their own undelivered post or erase it with their
      // account.
      allow delete: if isSignedIn()
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // The personal card — the one place a candidate's details are written by
    // the candidate, for the matchmakers they approve.
    //
    // Everything below is checked here, on the server, and never only in the
    // app: who may read a card, who may ask for it, and who may answer.
    // ------------------------------------------------------------------

    function durable() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function accessPath(ownerUid, matchmakerUid) {
      return /databases/$(database)/documents/cardAccess/$(ownerUid + '_' + matchmakerUid);
    }

    function grantIncludesMe(ownerUid) {
      let grant = get(accessPath(ownerUid, databaseUid())).data;
      return paired() ? grant.get('granteeUids', []) == get(membershipPath(request.auth.uid)).data.members
        : grant.matchmakerUid == request.auth.uid && grant.get('granteeUids', [request.auth.uid]).size() == 1;
    }

    function hasApprovedAccess(ownerUid) {
      return grantIncludesMe(ownerUid) && exists(accessPath(ownerUid, databaseUid()))
          && get(accessPath(ownerUid, databaseUid())).data.status == 'approved'
          && get(accessPath(ownerUid, databaseUid())).data.get('cardGranted', true) == true;
    }

    // The contacts rule: a matchmaker may ask for a card only if the card's
    // owner has them saved in their phone. Checked against the hashes the
    // owner published, and against the phone this account published as its
    // own — which must be this account's entry in the directory, so a phone
    // hash cannot be borrowed from somebody else's entry.
    function knownPhoneInContacts(ownerUid, uid) {
      let path = /databases/$(database)/documents/userPhones/$(uid);
      return exists(path) && exists(/databases/$(database)/documents/contactHashes/$(ownerUid))
        && get(/databases/$(database)/documents/phoneDirectory/$(get(path).data.phoneHash)).data.uid == uid
        && get(/databases/$(database)/documents/contactHashes/$(ownerUid)).data.hashes.hasAny([get(path).data.phoneHash]);
    }
    // One direction of sharing between two matchmakers (2026-11-20):
    // `matchmakerShares/{owner}_{reader}` — what [owner] shares with [reader].
    function shareRowPath(owner, reader) {
      return /databases/$(database)/documents/matchmakerShares/$(owner + '_' + reader);
    }
    function inOwnersContacts(ownerUid) {
      return paired() ?
        (knownPhoneInContacts(ownerUid, get(membershipPath(request.auth.uid)).data.members[0]) ||
         knownPhoneInContacts(ownerUid, get(membershipPath(request.auth.uid)).data.members[1])) :
        knownPhoneInContacts(ownerUid, request.auth.uid);
    }

    // The owner's card. The field list is the whitelist in
    // `PersonalCardCodec.cardFields` plus the bookkeeping around it: nothing
    // a matchmaker keeps privately can be written here, by construction.
    function activeCard(ownerUid) {
      let card = get(/databases/$(database)/documents/personalCards/$(ownerUid)).data;
      // Live = at least one photo AND at least 20 words of text — the same
      // line as `PersonalCardCodec.isActive` and `isActiveCard` (functions).
      return card.deleted == false && card.get('photoPaths', []).size() > 0 &&
        card.get('description', '') is string &&
        card.get('description', '').trim().size() > 0 &&
        card.get('description', '').trim().split('\\s+').size() >= 20;
    }
    function hasLookingAccess(ownerUid) {
      return grantIncludesMe(ownerUid) && exists(accessPath(ownerUid, databaseUid()))
        && get(accessPath(ownerUid, databaseUid())).data.status == 'approved'
        && get(accessPath(ownerUid, databaseUid())).data.get('lookingGranted', false) == true;
    }
    match /privateLookingPresence/{ownerUid} {
      allow read: if durable() && (request.auth.uid == ownerUid || hasApprovedAccess(ownerUid) || hasLookingAccess(ownerUid));
      allow write: if false;
    }
    match /privateLooking/{ownerUid} {
      allow read: if durable() && (request.auth.uid == ownerUid ||
        (hasLookingAccess(ownerUid) && get(/databases/$(database)/documents/personalCards/$(ownerUid)).data.deleted == false));
      // Callable verifies actual audio length and owns the field whitelist.
      allow write: if false;
    }
    match /publicStats/{id} { allow read: if durable(); allow write: if false; }

    match /personalCards/{ownerUid} {
      allow read: if durable()
                  && (request.auth.uid == ownerUid
                      || (resource.data.deleted == false
                          && hasApprovedAccess(ownerUid)));
      allow create, update: if durable()
                            && request.auth.uid == ownerUid
                            && request.resource.data.ownerUid == ownerUid
                            && request.resource.data.deleted is bool
                            && request.resource.data.status in
                                 ['available', 'busy', 'onBreak', 'mazelTov']
                            && request.resource.data.keys().hasOnly([
                                 'ownerUid', 'firstName', 'lastName', 'gender',
                                 'dateOfBirth', 'religiousLevel',
                                 'religiousLevelOther', 'city', 'description',
                                 'heightCm', 'maritalStatus', 'region',
                                 'preferredMinAge', 'preferredMaxAge',
                                 'preferredMinHeightCm', 'preferredMaxHeightCm',
                                 'preferredRegions', 'preferredMaritalStatuses',
                                 'preferredReligiousLevels',
                                 'preferredReligiousLevelOtherLabels',
                                 'photoPaths', 'tags', 'status', 'deleted', 'updatedAt', 'joinedAt', 'statusUpdatedAt',
                                 'photosShareable'])
                            && (request.resource.data.get('photosShareable', true) is bool)
                            && request.resource.data.get('joinedAt', null) == (resource == null ? null : resource.data.get('joinedAt', null))
                            && request.resource.data.get('statusUpdatedAt', null) == (resource == null ? null : resource.data.get('statusUpdatedAt', null))
                            && request.resource.data.photoPaths is list
                            && request.resource.data.photoPaths.size() <= 4
                            && (request.resource.data.get('tags', null) == null
                                || (request.resource.data.tags is list
                                    && request.resource.data.tags.size() <= 12))
                            && (request.resource.data.get('description', null) == null
                                || request.resource.data.description.size() <= 4000);
      // Deleting a card is a flag, never an erasure — it has to be
      // restorable. The document itself goes only with the account, which
      // is a Cloud Function's job.
      allow delete: if false;
    }

    // Who this account is, by phone. Looked up one number at a time and
    // never listed, so the directory cannot be read out as a whole. An entry
    // belongs to the account that wrote it.
    match /phoneDirectory/{phoneHash} {
      allow get: if durable() && (resource.data.uid == request.auth.uid ||
        (knownPhoneInContacts(resource.data.uid, request.auth.uid) && knownPhoneInContacts(request.auth.uid, resource.data.uid)));
      allow list: if false;
      allow create: if durable()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'name', 'matchmaker', 'hasCard',
                          'acceptsRequests', 'announces', 'updatedAt'])
                    && request.resource.data.get('acceptsRequests', true) is bool
                    && request.resource.data.get('announces', true) is bool
                    && request.resource.data.matchmaker is bool
                    && request.resource.data.hasCard is bool
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80;
      allow update: if durable()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'name', 'matchmaker', 'hasCard',
                          'acceptsRequests', 'announces', 'updatedAt'])
                    && request.resource.data.get('acceptsRequests', true) is bool
                    && request.resource.data.get('announces', true) is bool
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80;
      allow delete: if durable() && resource.data.uid == request.auth.uid;
    }

    match /userPhones/{uid} {
      allow read, write: if durable() && request.auth.uid == uid;
    }

    // The owner's address book as hashes. Read by the rules above, and by
    // nobody else.
    match /contactHashes/{uid} {
      allow read, write: if durable() && request.auth.uid == uid;
    }

    // A matchmaker's database, as the hashes of its friends' numbers — so the
    // server can tell exactly the matchmakers who have a friend in their
    // database when that friend writes a card. Read by the server only; the
    // owner may write it and read it back, nobody else may do either.
    match /databaseHashes/{uid} {
      allow read: if durable() && request.auth.uid == uid;
      allow write: if durable()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['hashes', 'updatedAt'])
                   && request.resource.data.hashes is list
                   && request.resource.data.hashes.size() <= 20000;
    }

    // The support view of one account's sync: its identity (uid, address,
    // ways in) and, per device, whether the account was read and the move
    // into it verified, record counts, last send/receive and the sync log's
    // last lines — collection names and error codes, never a record. Written
    // by the account itself; read by it and by support administrators only.
    match /accountHealth/{uid} {
      allow read: if (durable() && request.auth.uid == uid) || isSupportAdmin();
      allow create, update: if durable() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(
               ['uid', 'email', 'emailVerified', 'providers', 'createdAt',
                'updatedAt', 'devices'])
          && request.resource.data.devices is map
          && request.resource.data.devices.size() <= 100;
      allow delete: if durable() && request.auth.uid == uid;
    }

    // Usage events from the app, written in batches (`Telemetry`) and folded
    // by `onTelemetryBatch` into the monitoring documents below, then deleted.
    // Metadata only — feature ids, action codes, numbers, times. A phone can
    // only add a batch in its own name; nobody can read one.
    match /telemetryBatches/{batchId} {
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'did', 'v', 'p', 'ut', 'events', 'createdAt'])
          && request.resource.data.events is list
          && request.resource.data.events.size() > 0
          && request.resource.data.events.size() <= 500
          && (!('v' in request.resource.data) || (request.resource.data.v is string && request.resource.data.v.size() <= 20))
          && (!('p' in request.resource.data) || request.resource.data.p in ['android', 'ios', 'other'])
          && (!('ut' in request.resource.data) || request.resource.data.ut in ['single', 'matchmaker', 'both', 'unknown']);
      allow read, update, delete: if false;
    }

    // The monitoring itself — per account per day, per account, per version,
    // raised alerts and cached answers. Written by the server only; read by
    // support administrators only (user-level data never reaches anyone
    // else).
    match /analyticsUserDays/{id} {
      allow read: if isSupportAdmin();
      allow write: if false;
    }
    match /analyticsUsers/{uid} {
      allow read: if isSupportAdmin();
      allow write: if false;
    }
    match /analyticsVersions/{v} {
      allow read: if isSupportAdmin();
      allow write: if false;
    }
    match /analyticsAlerts/{id} {
      allow read: if isSupportAdmin();
      allow write: if false;
    }
    match /analyticsCache/{id} {
      allow read, write: if false;
    }

    // The prices costs are computed with, as versions: an administrator adds a
    // new version in force from now; earlier ones are never changed, so a
    // past month is never repriced.
    match /adminConfig/pricing {
      allow read: if isSupportAdmin();
      allow create, update: if isSupportAdmin()
          && request.resource.data.keys().hasOnly(['versions', 'updatedAt'])
          && request.resource.data.versions is list
          && request.resource.data.versions.size() <= 200
          && (resource == null
              || request.resource.data.versions.size() >= resource.data.versions.size())
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Alert thresholds, and the actual monthly bills typed in from Google
    // Cloud (shown beside the estimate).
    match /adminConfig/thresholds {
      allow read: if isSupportAdmin();
      allow create, update: if isSupportAdmin()
          && request.resource.data.keys().hasOnly(
               ['aiDailyIls', 'userDailyIls', 'featureSpikeFactor', 'errorRatePercent', 'updatedAt'])
          && request.resource.data.aiDailyIls is number
          && request.resource.data.userDailyIls is number
          && request.resource.data.featureSpikeFactor is number
          && request.resource.data.errorRatePercent is number;
      allow delete: if false;
    }
    match /adminConfig/billing {
      allow read: if isSupportAdmin();
      allow create, update: if isSupportAdmin()
          && request.resource.data.keys().hasOnly(['months', 'updatedAt'])
          && request.resource.data.months is map
          && request.resource.data.months.size() <= 240;
      allow delete: if false;
    }

    match /fcmTokens/{uid} {
      allow read, write: if durable() && request.auth.uid == uid;
    }

    // One document per owner and matchmaker, named `{ownerUid}_{matchmakerUid}`.
    //
    // The owner decides everything: approve, decline, block, revoke, or grant
    // access unasked. The matchmaker may only ask — and only when saved in
    // the owner's contacts and not blocked.
    // Whether the owner takes access requests at all — the switch on their
    // personal area, published on their directory entry. Missing means yes.
    function takesRequests(ownerUid) {
      let phonePath = /databases/$(database)/documents/userPhones/$(ownerUid);
      return !exists(phonePath)
          || get(/databases/$(database)/documents/phoneDirectory/$(get(phonePath).data.phoneHash))
                 .data.get('acceptsRequests', true) != false;
    }

    match /cardAccess/{accessId} {
      function fieldsOk() {
        return request.resource.data.keys().hasOnly([
                 'ownerUid', 'matchmakerUid', 'status', 'requestedBy',
                 'ownerName', 'matchmakerName', 'matchmakerGender',
                 'ownerPhoneHash', 'ownerPhone', 'invited', 'updatedAt',
                 'cardGranted', 'lookingGranted', 'lookingRequested', 'granteeUids', 'cardRequested',
                 'shareOnward', 'shareOnwardRequested'])
            && request.resource.data.get('cardGranted', false) is bool
            && request.resource.data.get('shareOnward', false) is bool
            && request.resource.data.get('shareOnwardRequested', false) is bool
            && request.resource.data.get('cardRequested', false) is bool
            && request.resource.data.get('lookingGranted', false) is bool
            && request.resource.data.get('lookingRequested', false) is bool
            && request.resource.data.get('matchmakerGender', null)
                 in [null, 'male', 'female']
            && accessId == request.resource.data.ownerUid + '_'
                           + request.resource.data.matchmakerUid
            && request.resource.data.status in
                 ['pending', 'approved', 'declined', 'blocked', 'revoked']
            && request.resource.data.updatedAt == request.time;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerUid;
      }

      function isMatchmaker() {
        return request.auth.uid == resource.data.matchmakerUid || request.auth.uid in resource.data.get('granteeUids', []);
      }

      allow read: if durable() && (isOwner() || isMatchmaker());

      allow create: if durable() && fieldsOk()
                    && (
                      // The owner granting (or blocking) on their own.
                      request.resource.data.ownerUid == request.auth.uid
                      ||
                      // A matchmaker asking.
                      (request.resource.data.matchmakerUid == databaseUid()
                       && request.resource.data.get('granteeUids', [request.auth.uid]) == (paired() ? get(membershipPath(request.auth.uid)).data.members : [request.auth.uid])
                       && request.resource.data.ownerUid != request.auth.uid
                       && request.resource.data.status == 'pending'
                       && request.resource.data.get('cardGranted', false) == false
                       && request.resource.data.get('lookingGranted', false) == false
                       && activeCard(request.resource.data.ownerUid)
                       && request.resource.data.requestedBy == 'matchmaker'
                       && inOwnersContacts(request.resource.data.ownerUid)
                       && takesRequests(request.resource.data.ownerUid))
                    );

      allow update: if durable() && fieldsOk()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.matchmakerUid == resource.data.matchmakerUid
                    && (
                      isOwner()
                      // The matchmaker asks the owner to let the card be shown
                      // to the matchmakers they are connected with
                      // (`shareOnward`). Only the owner can say yes.
                      || (isMatchmaker() && resource.data.status == 'approved'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareOnwardRequested', 'updatedAt'])
                        && request.resource.data.shareOnwardRequested == true
                        && resource.data.get('shareOnward', false) == false)
                      || (isMatchmaker() && resource.data.status != 'blocked'
                        && activeCard(resource.data.ownerUid) && takesRequests(resource.data.ownerUid) && inOwnersContacts(resource.data.ownerUid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cardRequested', 'updatedAt'])
                        && request.resource.data.cardRequested == true && resource.data.get('cardGranted', true) == false)
                      || (isMatchmaker() && resource.data.status != 'blocked'
                        && activeCard(resource.data.ownerUid)
                        && takesRequests(resource.data.ownerUid)
                        && inOwnersContacts(resource.data.ownerUid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lookingRequested', 'updatedAt'])
                        && request.resource.data.lookingRequested == true
                        && resource.data.get('lookingGranted', false) == false)
                      ||
                      // Asking again after a "not now" or a revoked grant.
                      // Never after a block: that is the owner's to lift.
                      (isMatchmaker()
                       && request.resource.data.get('granteeUids', []) == resource.data.get('granteeUids', [])
                       && resource.data.status in ['declined', 'revoked']
                       && request.resource.data.status == 'pending'
                       && request.resource.data.get('cardGranted', false) == false
                       && request.resource.data.get('lookingGranted', false) == false
                       && activeCard(request.resource.data.ownerUid)
                       && request.resource.data.requestedBy == 'matchmaker'
                       && inOwnersContacts(resource.data.ownerUid)
                       && takesRequests(resource.data.ownerUid))
                    );

      // The owner may remove any row. A matchmaker may withdraw a request or
      // leave a card — never delete a block, which would lift it.
      allow delete: if durable()
                    && (isOwner()
                        || (isMatchmaker() && resource.data.status != 'blocked'));
    }

    // ---- Sharing between two matchmakers (2026-11-20) -------------------
    //
    // **One direction, one pair, one decision.** `matchmakerShares/
    // {owner}_{reader}` says what [owner] shares with [reader]: the whole
    // database, the friends picked, or everything except some — or nothing
    // ("none"). Each matchmaker decides for each other matchmaker on their
    // own; nothing here is ever a pool of many databases. The card itself is
    // never copied per reader: the owner publishes one view of a card
    // (`networkCards`) and lists who may read it. [reader] may only *ask*
    // ("requested"). Both sides must be matchmakers who know each other from
    // the phone book. The old mutual `matchmakerConnections` model is gone.
    match /matchmakerShares/{shareId} {
      function shareOk(d) {
        return d.keys().hasOnly([
                 'ownerUid', 'readerUid', 'uids', 'mode', 'count',
                 'ownerName', 'readerName', 'createdAt', 'updatedAt'])
          && d.ownerUid is string && d.readerUid is string
          && shareId == d.ownerUid + '_' + d.readerUid
          && d.ownerUid != d.readerUid
          && d.uids == [d.ownerUid, d.readerUid]
          && d.mode in ['requested', 'all', 'selected', 'allExcept', 'none']
          && d.get('count', 0) is int && d.get('count', 0) >= 0
          && d.get('count', 0) <= 100000
          && d.get('ownerName', '') is string && d.get('ownerName', '').size() <= 80
          && d.get('readerName', '') is string && d.get('readerName', '').size() <= 80
          && d.createdAt is timestamp
          && d.updatedAt == request.time;
      }
      // Two matchmakers who know each other from the phone book — either one
      // saved the other — and the other side matchmakes here.
      function knownMatchmaker(other) {
        return (knownPhoneInContacts(request.auth.uid, other)
                || knownPhoneInContacts(other, request.auth.uid))
          && get(/databases/$(database)/documents/phoneDirectory/$(get(/databases/$(database)/documents/userPhones/$(other)).data.phoneHash)).data.matchmaker == true;
      }
      allow read: if durable() && request.auth.uid in resource.data.uids;
      allow create: if durable() && shareOk(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && (
                      (request.resource.data.ownerUid == request.auth.uid
                       && request.resource.data.mode != 'requested'
                       && knownMatchmaker(request.resource.data.readerUid))
                      ||
                      (request.resource.data.readerUid == request.auth.uid
                       && request.resource.data.mode == 'requested'
                       && request.resource.data.get('count', 0) == 0
                       && knownMatchmaker(request.resource.data.ownerUid))
                    );
      allow update: if durable() && shareOk(request.resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.readerUid == resource.data.readerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (
                      // The owner decides — any time, without asking anyone.
                      (request.auth.uid == resource.data.ownerUid
                       && request.resource.data.mode != 'requested')
                      ||
                      // The reader asks again after sharing stopped.
                      (request.auth.uid == resource.data.readerUid
                       && resource.data.mode == 'none'
                       && request.resource.data.mode == 'requested'
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['mode', 'readerName', 'updatedAt']))
                    );
      // The owner removes the row; the reader withdraws a request.
      allow delete: if durable()
                    && (request.auth.uid == resource.data.ownerUid
                        || (request.auth.uid == resource.data.readerUid
                            && resource.data.mode == 'requested'));
    }

    // "Yitzchak marked you as 'busy' on his phone — is that right?" A
    // matchmaker with access asks; only the owner answers.
    match /statusReports/{reportId} {
      allow read: if durable()
                  && (request.auth.uid == resource.data.ownerUid
                      || request.auth.uid == resource.data.matchmakerUid);
      allow create: if false
                    && request.resource.data.matchmakerUid == request.auth.uid
                    && hasApprovedAccess(request.resource.data.ownerUid)
                    && request.resource.data.keys().hasOnly([
                         'ownerUid', 'matchmakerUid', 'matchmakerName',
                         'status', 'resolution', 'createdAt'])
                    && request.resource.data.status in
                         ['available', 'busy', 'onBreak', 'mazelTov']
                    && request.resource.data.resolution == null
                    && request.resource.data.createdAt == request.time;
      allow update: if durable()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['resolution'])
                    && request.resource.data.resolution in ['confirmed', 'rejected'];
      allow delete: if durable()
                    && (request.auth.uid == resource.data.ownerUid
                        || request.auth.uid == resource.data.matchmakerUid);
    }

    // "השראה מהקהילה". One document per matchmaker holding the *words* of the
    // general tags they use — never who a tag is on. Owner-only: nobody else
    // can read which words a given matchmaker uses.
    match /tagUsage/{uid} {
      allow read, delete: if durable() && request.auth.uid == uid;
      allow create, update: if durable()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['tags', 'updatedAt'])
                            && request.resource.data.tags is list
                            && request.resource.data.tags.size() <= 200;
    }

    // The words and how many different matchmakers use each, written only by
    // the `onTagUsageWritten` function. A word becomes readable once three or
    // more matchmakers use it, so a query must carry `users >= 3`.
    match /communityTags/{tagKey} {
      // The words matchmakers use, once three of them do — and every word,
      // with how many matchmakers and how many singles' cards use it, for an
      // administrator improving the shared list.
      allow read: if durable()
                  && (resource.data.users >= 3 || isSupportAdmin());
      allow write: if false;
    }

    // The shared list of tags singles choose from and matchmakers are
    // offered. Every signed-in device reads it; only an administrator edits
    // it (add, delete, rename, reorder — the whole list is written at once).
    match /tagCatalog/base {
      allow read: if request.auth != null;
      allow create, update: if isSupportAdmin()
        && request.resource.data.keys().hasOnly(['tags', 'updatedAt'])
        && request.resource.data.tags is list
        && request.resource.data.tags.size() >= 1
        && request.resource.data.tags.size() <= 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // --- Sharing between matchmakers: who may see what -------------------
    //
    // **A trust network, never a public database.** [other] and the caller
    // share when either one shares something with the other right now.
    function activeShare(owner, reader) {
      return exists(shareRowPath(owner, reader))
        && get(shareRowPath(owner, reader)).data.mode in ['all', 'selected', 'allExcept'];
    }
    function sharesBetween(other) {
      return other != request.auth.uid
        && (activeShare(request.auth.uid, other) || activeShare(other, request.auth.uid));
    }
    // Two matchmakers who may send each other a card or an idea: they share,
    // or one has the other saved in their phone.
    function networkPeer(other) {
      return other != request.auth.uid
        && (sharesBetween(other)
            || knownPhoneInContacts(request.auth.uid, other)
            || knownPhoneInContacts(other, request.auth.uid));
    }

    // The cards a matchmaker chose to make visible to the matchmakers they
    // are connected with — `sharedCards/{ownerUid}/cards/{personId}`. View
    // only: the card's own fields, its photos' paths, "מה מחפש" and tags.
    // Never a phone number, a note, a go-between or anything the matchmaker
    // keeps for themselves (`SharedCardCodec.toRemote` is the whitelist).
    //
    // A card that is a single's own personal card may be shown only while
    // the single said so for this matchmaker (`cardAccess.shareOnward`); a
    // Function removes the copy the moment that answer goes.
    function sharedCardOk(d, ownerUid, personId) {
      return d.keys().hasOnly([
               'ownerUid', 'ownerName', 'personId', 'firstName', 'lastName',
               'gender', 'dateOfBirth', 'age', 'religiousLevel',
               'religiousLevelOther', 'city', 'description', 'heightCm',
               'maritalStatus', 'region', 'preferredMinAge', 'preferredMaxAge',
               'preferredMinHeightCm', 'preferredMaxHeightCm',
               'preferredRegions', 'preferredMaritalStatuses',
               'preferredReligiousLevels', 'preferredReligiousLevelOtherLabels',
               'tags', 'photoPaths', 'identity', 'cardOwnerUid', 'status',
               'readers', 'nameKey', 'updatedAt'])
        && d.ownerUid == ownerUid && d.personId == personId
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.gender in ['male', 'female']
        && d.description is string && d.description.size() > 0
        && d.description.size() <= 4000
        && d.photoPaths is list && d.photoPaths.size() > 0
        && d.photoPaths.size() <= 6
        && d.tags is list && d.tags.size() <= 40
        && d.status in ['available', 'busy', 'onBreak']
        && d.updatedAt == request.time
        && (d.get('cardOwnerUid', null) == null
            || (get(accessPath(d.cardOwnerUid, databaseUid())).data.status == 'approved'
                && get(accessPath(d.cardOwnerUid, databaseUid())).data.get('shareOnward', false) == true));
    }
    // The pre-2026-11-20 copies, readable and removable by their owner only
    // so the app can clean them up. Nobody else reads them any more.
    match /sharedCards/{ownerUid}/cards/{personId} {
      allow read, delete: if durable() && request.auth.uid == ownerUid;
    }

    // **One published view of a card, and the list of who may read it.**
    // `networkCards/{owner}_{personId}`: the shared-card whitelist plus
    // `readers` — the matchmakers the owner shares this card with right now —
    // and `nameKey` for a search by name on the server. Changing who sees a
    // card rewrites `readers`; the card is never copied per matchmaker. A
    // reader lists only what names them (`readers` array-contains), page by
    // page — never anybody's whole database.
    match /networkCards/{cardId} {
      allow read: if durable()
                  && (resource.data.ownerUid == request.auth.uid
                      || request.auth.uid in resource.data.readers);
      allow create, update: if durable()
                            && request.resource.data.personId is string
                            && cardId == request.auth.uid + '_' + request.resource.data.personId
                            && request.resource.data.readers is list
                            && request.resource.data.readers.size() > 0
                            && request.resource.data.readers.size() <= 500
                            && !(request.auth.uid in request.resource.data.readers)
                            && request.resource.data.nameKey is string
                            && request.resource.data.nameKey.size() <= 80
                            && sharedCardOk(request.resource.data, request.auth.uid, request.resource.data.personId);
      allow delete: if durable() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- The couple space (2026-11-20) -----------------------------------
    //
    // Two personal accounts, two personal databases, and one tie between
    // them: `partnerships/{a}_{b}` (uids sorted). While it is active, each
    // partner reads the other's whole database — the card fields, photos,
    // tags and "מה מחפש" each one publishes to `partnerCards/{uid}/cards`,
    // never a phone, a note, history or a reminder. Ending it closes every
    // read at once; nothing moves between the databases.
    match /partnerships/{pairId} {
      function pairOk(d) {
        return d.keys().hasOnly([
                 'uids', 'fromUid', 'toUid', 'status', 'names',
                 'createdAt', 'updatedAt', 'endedAt'])
          && d.uids is list && d.uids.size() == 2
          && d.uids[0] < d.uids[1]
          && pairId == d.uids[0] + '_' + d.uids[1]
          && d.fromUid in d.uids && d.toUid in d.uids && d.fromUid != d.toUid
          && d.status in ['pending', 'active', 'ended']
          && d.names is map
          && d.updatedAt == request.time;
      }
      allow read: if durable() && request.auth.uid in resource.data.uids;
      // An invitation: by the one who sends it, waiting for the other's yes.
      // A pair that ended may be invited again by either side.
      allow create: if durable() && pairOk(request.resource.data)
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;
      allow update: if durable() && pairOk(request.resource.data)
                    && request.auth.uid in resource.data.uids
                    && request.resource.data.uids == resource.data.uids
                    && (
                      // The one invited says yes — mutual approval.
                      (resource.data.status == 'pending'
                       && resource.data.toUid == request.auth.uid
                       && request.resource.data.status == 'active')
                      ||
                      // Either side ends it (or withdraws an invitation).
                      (request.resource.data.status == 'ended')
                      ||
                      // After an end, either side invites again.
                      (resource.data.status == 'ended'
                       && request.resource.data.status == 'pending'
                       && request.resource.data.fromUid == request.auth.uid)
                    );
      allow delete: if false;
    }

    function partnerCardOk(d, ownerUid, personId) {
      return d.keys().hasOnly([
               'ownerUid', 'ownerName', 'personId', 'firstName', 'lastName',
               'gender', 'dateOfBirth', 'age', 'religiousLevel',
               'religiousLevelOther', 'city', 'description', 'heightCm',
               'maritalStatus', 'region', 'preferredMinAge', 'preferredMaxAge',
               'preferredMinHeightCm', 'preferredMaxHeightCm',
               'preferredRegions', 'preferredMaritalStatuses',
               'preferredReligiousLevels', 'preferredReligiousLevelOtherLabels',
               'tags', 'photoPaths', 'identity', 'cardOwnerUid', 'status',
               'updatedAt'])
        && d.ownerUid == ownerUid && d.personId == personId
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.description is string && d.description.size() <= 4000
        && d.photoPaths is list && d.photoPaths.size() <= 6
        && d.tags is list && d.tags.size() <= 40
        && d.status in ['available', 'busy', 'onBreak']
        && d.updatedAt == request.time;
    }
    match /partnerCards/{ownerUid}/cards/{personId} {
      allow read: if durable() && (request.auth.uid == ownerUid || partnerOf(ownerUid));
      allow create, update: if durable() && request.auth.uid == ownerUid
                            && partnerCardOk(request.resource.data, ownerUid, personId);
      allow delete: if durable() && request.auth.uid == ownerUid;
    }

    // One card sent by its owner to one matchmaker — in a chat, on purpose.
    // The same whitelist as a shared card; only the matchmaker it was sent
    // to reads it, and only while the two know each other or share. A single's own card needs the same consent as in the pool.
    // Since 2026-11-21 also a candidate's card sent by a matchmaker to a
    // single they are tied to by the single's own card ("יש לי רעיון
    // בשבילך") — viewed in the app, never passed on.
    match /sentCards/{ownerUid}/to/{toUid}/cards/{personId} {
      allow read: if durable()
                  && (request.auth.uid == ownerUid
                      || (request.auth.uid == toUid
                          && (networkPeer(ownerUid) || cardTie(ownerUid, toUid))));
      allow create, update: if durable() && request.auth.uid == ownerUid
                            && (networkPeer(toUid) || cardTie(ownerUid, toUid))
                            && sharedCardOk(request.resource.data, ownerUid, personId);
      allow delete: if durable() && request.auth.uid == ownerUid;
    }

    // A matchmaker offering an idea to a connected matchmaker: their own
    // candidate (a snapshot of the card, same whitelist as a shared card)
    // with somebody from the other's shared cards. Only the side asked
    // answers. Once approved, each side keeps its own half of the idea; the
    // `sides` map is where each writes where *its* half stands, for the other
    // to see — and nothing else.
    match /ideaProposals/{proposalId} {
      // The one record of a shared idea both matchmakers move: the status
      // and who was asked, and who moved it last.
      function sharedIdeaOk(i) {
        return i == null
          || (i is map
              && i.keys().hasOnly(['status', 'askedMaleAt', 'askedFemaleAt', 'updatedBy', 'updatedAt'])
              && i.status in ['idea', 'checking', 'unavailable', 'dating', 'dated', 'rejected', 'married']
              && (i.get('askedMaleAt', null) == null || i.askedMaleAt is timestamp)
              && (i.get('askedFemaleAt', null) == null || i.askedFemaleAt is timestamp)
              && i.updatedBy is string);
      }
      // Whoever writes the shared idea signs it, now.
      function sharedIdeaSigned(before, after) {
        return !after.diff(before).affectedKeys().hasAny(['idea'])
          || (after.idea.updatedBy == request.auth.uid
              && after.idea.updatedAt == request.time);
      }
      function proposalOk(d) {
        return d.keys().hasOnly([
                 'fromUid', 'toUid', 'uids', 'fromName', 'toName', 'status',
                 'target', 'candidate', 'note', 'sides', 'idea', 'createdAt', 'updatedAt'])
          && d.uids == [d.fromUid, d.toUid] && d.fromUid != d.toUid
          && sharedIdeaOk(d.get('idea', null))
          && d.fromName is string && d.fromName.size() <= 80
          && d.toName is string && d.toName.size() <= 80
          && d.status in ['pending', 'approved', 'opened', 'declined', 'withdrawn']
          && d.target is map && d.target.personId is string
          && d.candidate is map && d.candidate.personId is string
          && d.candidate.get('description', '') is string
          && d.candidate.get('description', '').size() <= 4000
          && d.candidate.get('photoPaths', []) is list
          && d.candidate.get('photoPaths', []).size() <= 6
          && d.get('note', '') is string && d.get('note', '').size() <= 500
          && d.sides is map
          && d.updatedAt == request.time;
      }
      allow read: if durable() && request.auth.uid in resource.data.uids;
      allow create: if durable() && proposalOk(request.resource.data)
                    && request.resource.data.fromUid == request.auth.uid
                    && (request.resource.data.get('idea', null) == null
                        || request.resource.data.idea.updatedBy == request.auth.uid)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.sides.size() == 0
                    && (
                      // Between connected matchmakers: offered, and opened by
                      // the yes of the one who holds the card.
                      (request.resource.data.status == 'pending'
                       && networkPeer(request.resource.data.toUid)
                       && ((exists(/databases/$(database)/documents/networkCards/$(request.resource.data.toUid + '_' + request.resource.data.target.personId))
                            && request.auth.uid in get(/databases/$(database)/documents/networkCards/$(request.resource.data.toUid + '_' + request.resource.data.target.personId)).data.readers)
                           || exists(/databases/$(database)/documents/sentCards/$(request.resource.data.toUid)/to/$(request.auth.uid)/cards/$(request.resource.data.target.personId)))
                       && (request.resource.data.candidate.get('cardOwnerUid', null) == null
                           || get(accessPath(request.resource.data.candidate.cardOwnerUid, databaseUid())).data.get('shareOnward', false) == true))
                      ||
                      // Between partners: open at once, on a card of the
                      // partner's database — no request for approval.
                      (request.resource.data.status in ['approved', 'opened']
                       && partnerOf(request.resource.data.toUid)
                       && exists(/databases/$(database)/documents/partnerCards/$(request.resource.data.toUid)/cards/$(request.resource.data.target.personId)))
                    );
      allow update: if durable() && proposalOk(request.resource.data)
                    && request.auth.uid in resource.data.uids
                    && request.resource.data.uids == resource.data.uids
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.candidate == resource.data.candidate
                    && request.resource.data.target == resource.data.target
                    && sharedIdeaSigned(resource.data, request.resource.data)
                    && (
                      // The side asked answers.
                      (resource.data.status == 'pending'
                       && resource.data.toUid == request.auth.uid
                       && request.resource.data.status in ['approved', 'opened', 'declined']
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'toName', 'idea']))
                      ||
                      // The side who asked takes it back.
                      (resource.data.status == 'pending'
                       && resource.data.fromUid == request.auth.uid
                       && request.resource.data.status == 'withdrawn'
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                      ||
                      // Agreed is not yet open: either side opens the idea
                      // the moment they really ask the two friends.
                      (resource.data.status == 'approved'
                       && request.resource.data.status == 'opened'
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'idea']))
                      ||
                      // Either side moves the one shared idea, and writes
                      // where its own half stands.
                      (resource.data.status in ['approved', 'opened']
                       && request.resource.data.status == resource.data.status
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sides', 'idea', 'updatedAt'])
                       && request.resource.data.sides.diff(resource.data.sides).affectedKeys().hasOnly([request.auth.uid]))
                    );
      allow delete: if false;
    }

    // Chats. One continuing chat per pair of matchmakers (`{a}_{b}`, uids
    // sorted) — every card and idea between them is talked about in the same
    // thread. `type` leaves room for groups later; only `direct` chats can be
    // opened today, and only between connected matchmakers.
    // A single and a matchmaker are tied by a card when either asked the
    // other or one gave the other access — anything but a block.
    function cardTie(a, b) {
      return (exists(accessPath(a, b)) && get(accessPath(a, b)).data.status != 'blocked')
          || (exists(accessPath(b, a)) && get(accessPath(b, a)).data.status != 'blocked');
    }
    // Two accounts in one couple space (`partnerships/{a}_{b}`, sorted).
    function partnerPath(a, b) {
      return /databases/$(database)/documents/partnerships/$(a < b ? a + '_' + b : b + '_' + a);
    }
    function partnerOf(other) {
      return other != request.auth.uid
        && exists(partnerPath(request.auth.uid, other))
        && get(partnerPath(request.auth.uid, other)).data.status == 'active';
    }

    // Who may **start** a conversation with whom — a user is one person,
    // never a role, so this asks about the two accounts and not about what
    // either of them is: a single and a matchmaker tied by a card (asked,
    // approved, anything but a block), matchmakers who share or know each
    // other from the phone book, and partners.
    //
    // Asked only when the conversation is created. **Once it exists it stays
    // a conversation**: a card access revoked or a share stopped changes the
    // card's permissions, not the chat (2026-11-21).
    //
    // **Ten document reads at most.** Firestore refuses a rule that reads more
    // than ten documents, and the old order — card tie, shares, partners, then
    // a phone-book check each way — reached eleven when only the last clause
    // was true, so a matchmaker could never start a chat with somebody who
    // had *them* saved but not the other way round. Now the server's own
    // reading of each side's phone book (`users/{uid}/private/helpers.uids`,
    // one document per side) comes first, and the expensive phone-book check
    // is asked one way only: 2 + 2 + 2 + 1 + 3 = 10.
    function knowsFromContacts(owner, other) {
      let path = /databases/$(database)/documents/users/$(owner)/private/helpers;
      return exists(path) && get(path).data.get('uids', []).hasAny([other]);
    }
    function chatPeerAllowed(other) {
      return knowsFromContacts(request.auth.uid, other)
        || knowsFromContacts(other, request.auth.uid)
        || cardTie(request.auth.uid, other)
        || sharesBetween(other)
        || partnerOf(other)
        || knownPhoneInContacts(request.auth.uid, other);
    }

    // The per-member unread counters: the sender adds one for the other side
    // and zeroes their own; a reader zeroes their own. Nothing else.
    function unreadOk(before, after, other) {
      let b = before.get('unread', {});
      let a = after.get('unread', {});
      let changed = a.diff(b).affectedKeys();
      return changed.hasOnly([request.auth.uid, other])
        && (!changed.hasAny([request.auth.uid]) || a[request.auth.uid] == 0)
        && (!changed.hasAny([other])
            || (after.get('lastFromUid', '') == request.auth.uid
                && a[other] == b.get(other, 0) + 1));
    }

    // One conversation per pair of accounts (`{a}_{b}`, uids sorted) —
    // whatever either of them is: single, matchmaker or both. Every card,
    // idea and recording between them is in the same thread.
    match /chats/{chatId} {
      function member() {
        return request.auth.uid in resource.data.members;
      }
      function otherOf(d) {
        return d.members[0] == request.auth.uid ? d.members[1] : d.members[0];
      }
      function lastOk(d) {
        return d.get('lastText', '') is string
          && d.get('lastText', '').size() <= 200
          && d.get('lastType', 'text') in ['text', 'voice', 'image', 'card', 'idea', 'ideaOffer', 'system']
          && d.get('names', {}) is map
          && d.get('photos', {}) is map;
      }
      allow read: if durable() && member();
      // Created by its first message, in the same write. The client writes
      // the chat with a merge, so the same write is a create the first time
      // and an update every time after — no read needed to know which.
      allow create: if durable()
                    && request.resource.data.keys().hasOnly([
                         'members', 'type', 'kind', 'names', 'photos', 'createdAt', 'updatedAt',
                         'lastText', 'lastFromUid', 'lastType', 'lastAt', 'readAt', 'unread'])
                    && request.resource.data.type == 'direct'
                    && request.resource.data.get('kind', 'direct') is string
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.resource.data.members[0] < request.resource.data.members[1]
                    && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                    && request.auth.uid in request.resource.data.members
                    && lastOk(request.resource.data)
                    && request.resource.data.get('lastFromUid', request.auth.uid) == request.auth.uid
                    && request.resource.data.get('readAt', {}).keys().hasOnly([request.auth.uid])
                    && request.resource.data.get('photos', {}).keys().hasOnly([request.auth.uid])
                    && unreadOk({}, request.resource.data, otherOf(request.resource.data))
                    && chatPeerAllowed(otherOf(request.resource.data));
      allow update: if durable() && member()
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ['lastText', 'lastFromUid', 'lastType', 'lastAt', 'readAt', 'unread',
                          'names', 'photos', 'updatedAt'])
                    && lastOk(request.resource.data)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFromUid', 'lastType'])
                        || request.resource.data.lastFromUid == request.auth.uid)
                    && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.get('photos', {}).diff(resource.data.get('photos', {})).affectedKeys().hasOnly([request.auth.uid])
                    && unreadOk(resource.data, request.resource.data, otherOf(resource.data));
      allow delete: if false;

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        // Read as it will be after this write: the first message arrives in
        // the same batch that creates its chat.
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function mediaOk(d) {
          return d.get('media', null) == null
            || (d.media is map
                && d.media.keys().hasOnly(['path', 'durationMs', 'width', 'height', 'size', 'mime'])
                && d.media.path is string
                && d.media.path.matches('chats/' + chatId + '/[A-Za-z0-9_-]+[.][a-z0-9]{2,5}')
                && d.media.get('size', 0) is int
                && d.media.get('size', 0) <= 15 * 1024 * 1024);
        }
        function refOk(d) {
          return d.get('ref', null) == null
            || (d.ref is map
                && d.ref.keys().hasOnly(['kind', 'id', 'ownerUid', 'label'])
                && d.ref.kind in ['card', 'idea', 'proposal', 'person', 'ideaOffer']
                && d.ref.id is string
                && d.ref.id.size() <= 300
                && d.ref.label is string
                && d.ref.label.size() <= 120);
        }
        function offerOk(d) {
          return d.get('offer', null) == null
            || (d.offer is map
                && d.offer.keys().hasOnly(['personId', 'name', 'summary', 'matchId'])
                && d.offer.personId is string && d.offer.personId.size() <= 200
                && d.offer.name is string && d.offer.name.size() <= 120
                && d.offer.get('summary', '') is string && d.offer.get('summary', '').size() <= 300);
        }
        allow read: if durable() && request.auth.uid in chat().members;
        allow create: if durable()
                      && request.auth.uid in chatAfter().members
                      && request.resource.data.keys().hasOnly(['fromUid', 'type', 'text', 'at', 'ref', 'media', 'offer'])
                      && request.resource.data.fromUid == request.auth.uid
                      && request.resource.data.at == request.time
                      && request.resource.data.get('type', 'text') in ['text', 'voice', 'image', 'card', 'idea', 'ideaOffer']
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      && (request.resource.data.get('type', 'text') != 'text'
                          || request.resource.data.text.size() > 0)
                      && (!(request.resource.data.get('type', 'text') in ['voice', 'image'])
                          || request.resource.data.get('media', null) != null)
                      && (request.resource.data.get('type', 'text') != 'ideaOffer'
                          || request.resource.data.get('offer', null) != null)
                      && mediaOk(request.resource.data)
                      && refOk(request.resource.data)
                      && offerOk(request.resource.data);
        // "יש לי רעיון בשבילך": the single answers once — approve, decline
        // (with a reason only the matchmaker reads, or none), or "שאל את
        // השדכן". Nothing else on a message ever changes.
        allow update: if durable()
                      && request.auth.uid in chat().members
                      && resource.data.get('type', 'text') == 'ideaOffer'
                      && resource.data.fromUid != request.auth.uid
                      && resource.data.get('answer', null) == null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answerReason', 'answeredAt'])
                      && request.resource.data.answer in ['approved', 'declined']
                      && request.resource.data.answeredAt == request.time
                      && request.resource.data.get('answerReason', '') is string
                      && request.resource.data.get('answerReason', '').size() <= 500;
        allow delete: if false;
      }
    }

    // Anything not named above is closed. Without this, a path added later
    // starts life world-readable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
